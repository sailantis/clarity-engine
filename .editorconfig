[EditorConfig](https://editorconfig.org) settings for editors that support it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.clarity.html]
indent_size = 2

[*.svg]
insert_final_newline = false
trim_trailing_whitespace = false
