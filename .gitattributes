# Normalize line endings in the repository, keep PHP files as LF.
* text=auto
*.php text eol=lf

# Dev-only files are not shipped in the Composer archive.
# `docs/` is intentionally KEPT: the README links into it.
#
# `composer.lock` IS tracked, so dev installs and CI resolve the same versions.
# Composer never reads a dependency's lock file, so this costs consumers
# nothing — but it must still be kept out of the archive, where it would look
# like authoritative advice for the consumer's own resolution.
/composer.lock export-ignore
/tests/ export-ignore
/scripts/ export-ignore
/phpunit.xml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github/ export-ignore
/CHANGELOG.md export-ignore
/CONTRIBUTING.md export-ignore
/temp/ export-ignore
