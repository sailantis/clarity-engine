{
  "name": "sailantis/clarity-engine",
  "description": "A fast and powerful Template engine for PHP inspired by Twig.",
  "type": "library",
  "keywords": ["template", "template-engine", "templating", "twig", "view", "compiler"],
  "homepage": "https://github.com/sailantis/clarity-engine",
  "support": {
    "issues": "https://github.com/sailantis/clarity-engine/issues",
    "source": "https://github.com/sailantis/clarity-engine"
  },
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpdocumentor/reflection-docblock": "^6.0"
  },
  "suggest": {
    "ext-intl": "Locale-aware formatting via IntlFormatModule (format_number, format_currency, format_date, ...)",
    "ext-redis": "Caching translation lookups via RedisCachingLoader"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Sailantis"
    }
  ],
  "autoload": {
    "psr-4": {
      "Clarity\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Clarity\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
